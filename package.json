{
  "name": "lantern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "assets:import": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/surfaces/export-scenery.mjs",
    "assets:export-character": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/characters/playable.mjs",
    "assets:export-protagonist-draft": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/characters/protagonist.mjs",
    "assets:download-mixamo": "node scripts/agents/run.mjs --resource heavy -- python3 scripts/assets/mixamo/mixamo-download-collector.py",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:run": "electron electron/main.cjs",
    "desktop:check": "node scripts/agents/run.mjs --resource gpu -- electron electron/main.cjs --background",
    "assets:import-library": "node scripts/agents/run.mjs --resource heavy -- python3 scripts/assets/synty/import-library.py",
    "assets:verify-library": "python3 scripts/assets/synty/library/verify.py",
    "typecheck": "node scripts/agents/run.mjs --resource checks -- tsc --noEmit",
    "lint": "node scripts/agents/run.mjs --resource checks -- node scripts/lint.mjs",
    "test": "node scripts/agents/run.mjs --resource checks -- vitest run",
    "docs:check": "node scripts/check-docs.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "check": "node scripts/check.mjs",
    "levels:dev": "node scripts/levels/dev.mjs",
    "levels:capture": "node scripts/agents/run.mjs --resource gpu --reuse-preview -- node scripts/levels/capture.mjs",
    "levels:check": "node scripts/levels/check.mjs",
    "levels:assets": "node scripts/levels/check.mjs --assets",
    "levels:measure": "node scripts/agents/run.mjs --resource gpu --reuse-preview --require-reason -- node scripts/levels/measure.mjs",
    "levels:stop": "node scripts/levels/stop.mjs",
    "levels:calibrate": "node scripts/agents/run.mjs --resource gpu --reuse-preview -- node scripts/levels/calibrate.mjs",
    "levels:find": "node scripts/levels/find.mjs",
    "assets:export-characters": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/characters/export.mjs",
    "characters:capture": "node scripts/agents/run.mjs --resource gpu -- node scripts/assets/characters/capture.mjs",
    "lighting:bake": "node scripts/agents/run.mjs --resource gpu --reuse-preview -- node scripts/levels/bake-lighting.mjs",
    "check:full": "node scripts/check.mjs --full",
    "agent:start": "node scripts/agents/cli.mjs start",
    "agent:dev": "node scripts/agents/cli.mjs dev",
    "agent:finish": "node scripts/agents/cli.mjs finish",
    "agent:status": "node scripts/agents/cli.mjs status",
    "agent:cleanup": "node scripts/agents/cli.mjs cleanup",
    "agent:sources": "node scripts/agents/cli.mjs sources",
    "main:dev": "node scripts/agents/cli.mjs main",
    "audio:prepare": "node scripts/assets/audio/prepare.mjs",
    "agent:context": "node scripts/agents/context.mjs",
    "agent:inspect": "node scripts/agents/inspect.mjs",
    "agent:source": "node scripts/agents/source.mjs",
    "agent:diagnostics": "node scripts/agents/diagnostics.mjs",
    "desktop:prepare": "node scripts/desktop/candidate.mjs prepare",
    "desktop:verify": "node scripts/desktop/candidate.mjs verify",
    "desktop:publish": "node scripts/desktop/candidate.mjs publish",
    "desktop:dispatch": "node scripts/desktop/candidate.mjs dispatch",
    "desktop:package": "node scripts/desktop/package.mjs",
    "assets:export-merchant": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/characters/merchant.mjs",
    "assets:prepare-particle-study": "node scripts/agents/run.mjs --resource heavy -- python3 scripts/assets/synty/prepare-particle-study.py",
    "materials:check": "node scripts/assets/surfaces/validate.mjs",
    "materials:probe": "node scripts/agents/run.mjs --resource gpu --reuse-preview -- node scripts/materials/probe.mjs",
    "assets:import-asterfall": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/asterfall/import.mjs",
    "assets:import-ashen-veil": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/ashen-veil/import.mjs",
    "assets:import-generated": "node scripts/agents/run.mjs --resource heavy -- node scripts/assets/generated-packs/import.mjs",
    "assets:review": "node scripts/assets/review/cli.mjs",
    "assets:review:report": "node scripts/assets/review/cli.mjs --report",
    "assets:review:check": "node scripts/assets/review/cli.mjs --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@pmndrs/upscaler": "0.2.0",
    "navcat": "0.4.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astral-sh/ruff-wasm-nodejs": "0.16.10",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron/asar": "4.3.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "stylelint": "17.16.0",
    "tar": "7.5.22",
    "three-plume": "0.1.1",
    "tslfx": "0.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "main": "electron/main.cjs",
  "description": "Lantern fantasy action RPG",
  "author": "Talyen",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "three-plume": {
      "three": "$three"
    }
  }
}
